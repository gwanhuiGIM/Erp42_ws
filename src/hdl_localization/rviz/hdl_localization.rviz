Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF2
        - /PointCloud21
        - /PointCloud22
        - /PointCloud23
        - /Odometry1
      Splitter Ratio: 0.5
    Tree Height: 389
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: GlobalMap
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (m): 0.05
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability: Volatile
        History Policy: Keep Last
        Reliability: Reliable
        Value: /globalmap
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: InputPoints
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (m): 0.02
      Size (Pixels): 2
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability: Volatile
        History Policy: Keep Last
        Reliability: Reliable
        Value: /velodyne_points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Decay Time: 0
      Enabled: true
      Name: AlignedPoints
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (m): 0.03
      Size (Pixels): 3
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability: Volatile
        History Policy: Keep Last
        Reliability: Reliable
        Value: /aligned_points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 0.3
          Value: true
      Enabled: true
      Keep: 100
      Name: Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.1
        Color: 255; 25; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 0.7
        Shaft Radius: 0.05
        Value: Arrow
      Topic:
        Depth: 5
        Durability: Volatile
        History Policy: Keep Last
        Reliability: Reliable
        Value: /odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Theta std deviation: 0.261799
      Topic:
        Depth: 5
        Durability: Volatile
        History Policy: Keep Last
        Reliability: Reliable
        Value: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability: Volatile
        History Policy: Keep Last
        Reliability: Reliable
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60.9
      Focal Point:
        X: 10
        Y: 10
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Yaw: 0.785

